---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import bbossMobile1 from "../../assets/img/projects/bboss-mobile-1.jpg";
import bbossMobile2 from "../../assets/img/projects/bboss-mobile-2.jpg";
import bbossMobile3 from "../../assets/img/projects/bboss-mobile-3.jpg";
import bbossMobile4 from "../../assets/img/projects/bboss-mobile-4.jpg";

const screens = [
  {
    src: bbossMobile1,
    alt: "B-Boss Club customer hub home screen",
  },
  {
    src: bbossMobile2,
    alt: "B-Boss Club booking flow on a mobile screen",
  },
  {
    src: bbossMobile3,
    alt: "B-Boss Club customer history on a mobile screen",
  },
  {
    src: bbossMobile4,
    alt: "B-Boss Club loyalty screen in the customer hub",
  },
];

const ecosystem = [
  {
    name: { en: "Barbershop Management", pt: "Gestão da Barbearia" },
    type: "Web",
    detail: {
      en: "Scheduling, team, and finances for the shop operation.",
      pt: "Agenda, equipe e finanças para a operação da barbearia.",
    },
  },
  {
    name: { en: "Customer Hub", pt: "Hub do Cliente" },
    type: "PWA",
    detail: {
      en: "Booking, history, and loyalty for end customers.",
      pt: "Agendamento, histórico e fidelidade para o cliente final.",
    },
  },
  {
    name: { en: "Barber App", pt: "App do Barbeiro" },
    type: "PWA",
    detail: {
      en: "Agenda and earnings for each professional.",
      pt: "Agenda e ganhos para cada profissional.",
    },
  },
  {
    name: { en: "Admin backoffice", pt: "Backoffice Admin" },
    type: "Web",
    detail: {
      en: "Marketplace and oversight for the business team.",
      pt: "Marketplace e gestão para o time de negócio.",
    },
  },
];

const decisions = [
  {
    title: { en: "Single codebase", pt: "Uma base de código" },
    body: {
      en: "A shared architecture and design system kept four surfaces consistent — and shippable by a small team.",
      pt: "Arquitetura e design system compartilhados mantiveram quatro superfícies consistentes — e entregáveis por um time pequeno.",
    },
  },
  {
    title: { en: "PWA over native", pt: "PWA em vez de nativo" },
    body: {
      en: "The mobile surfaces could ship faster across devices while keeping installable app behavior.",
      pt: "As superfícies mobile saíram mais rápido em qualquer aparelho, mantendo comportamento de app instalável.",
    },
  },
  {
    title: { en: "Design QA in handoff", pt: "QA de design no handoff" },
    body: {
      en: "Components, spacing, states, and interaction details were checked as part of implementation, not after it.",
      pt: "Componentes, espaçamento, estados e detalhes de interação eram checados como parte da implementação, não depois.",
    },
  },
];
---

<Base
  title="B-Boss Club — case study · Gabriel Andrade"
  description="A case study for B-Boss Club, an ecosystem for barbershops with management, customer, barber, and admin surfaces sharing one design system and one codebase."
>
  <Nav />

  <main class="case" id="main">
    <section class="case-hero">
      <div class="wrap">
        <a class="back-link mono i18n" href="/#work" data-en="← Back to work" data-pt="← Voltar aos projetos">← Back to work</a>

        <div class="head case-head" data-reveal>
          <div class="k i18n" data-en="Case study" data-pt="Case study">Case study</div>
          <h1>B-Boss Club</h1>
          <p
            class="i18n"
            data-en="An ecosystem for barbershops: management, a customer hub, a barber app, and an admin backoffice, sharing one design system and one codebase. I led design and engineering end to end."
            data-pt="Um ecossistema para barbearias: gestão, hub do cliente, app do barbeiro e backoffice admin, compartilhando um design system e uma base de código. Liderei design e engenharia de ponta a ponta."
          >
            An ecosystem for barbershops: management, a customer hub, a barber app, and an admin backoffice,
            sharing one design system and one codebase. I led design and engineering end to end.
          </p>
          <div class="tags">
            <span class="tag">SaaS</span>
            <span class="tag">Marketplace</span>
            <span class="tag i18n" data-en="Design system" data-pt="Design system">Design system</span>
            <span class="tag">PWA</span>
            <span class="tag i18n" data-en="Front to back" data-pt="Front to back">Front to back</span>
          </div>
          <p class="metric mono i18n" data-en="Ecosystem of 4 apps · one codebase · one design system" data-pt="Ecossistema de 4 apps · uma base · um design system">Ecosystem of 4 apps · one codebase · one design system</p>
        </div>
      </div>
    </section>

    <section class="case-section">
      <div class="wrap split" data-reveal>
        <div class="head section-head">
          <div class="k i18n" data-en="The problem" data-pt="O problema">The problem</div>
          <h2 class="i18n" data-en="Fragmented tools in a large market." data-pt="Ferramentas fragmentadas num mercado enorme.">Fragmented tools in a large market.</h2>
        </div>
        <div class="copy">
          <p
            class="i18n"
            data-en="Brazil has 600k+ registered barbershops, but digitalization is fragmented. Shop management, the end customer, and the barber usually sit in separate tools with no consolidated hub. B-Boss is that hub."
            data-pt="O Brasil tem 600 mil+ barbearias registradas, mas a digitalização é fragmentada. Gestão da barbearia, cliente final e barbeiro costumam viver em ferramentas separadas, sem um hub consolidado. O B-Boss é esse hub."
          >
            Brazil has 600k+ registered barbershops, but digitalization is fragmented. Shop management,
            the end customer, and the barber usually sit in separate tools with no consolidated hub.
            B-Boss is that hub.
          </p>
          <p class="stack mono i18n" data-en="600,000+ registered barbershops · zero consolidated hubs" data-pt="600 mil+ barbearias registradas · zero hubs consolidados">600,000+ registered barbershops · zero consolidated hubs</p>
        </div>
      </div>
    </section>

    <section class="case-section">
      <div class="wrap split" data-reveal>
        <div class="head section-head">
          <div class="k i18n" data-en="The approach" data-pt="A abordagem">The approach</div>
          <h2 class="i18n" data-en="Design + engineering, end to end." data-pt="Design + engenharia, de ponta a ponta.">Design + engineering, end to end.</h2>
        </div>
        <div class="copy">
          <p
            class="i18n"
            data-en="I designed the system from scratch, then built the web management dashboard, the customer hub as a PWA, and the shared frontend architecture from Figma to production."
            data-pt="Desenhei o design system do zero, depois construí o painel web de gestão, o hub do cliente como PWA e a arquitetura frontend compartilhada, do Figma à produção."
          >
            I designed the system from scratch, then built the web management dashboard, the customer hub
            as a PWA, and the shared frontend architecture from Figma to production.
          </p>
          <p class="stack mono">Vite monorepo · PWA · React · TypeScript · Tailwind</p>
        </div>
      </div>
    </section>

    <section class="case-section">
      <div class="wrap" data-reveal>
        <div class="head">
          <div class="k i18n" data-en="Key decisions" data-pt="Decisões-chave">Key decisions</div>
          <h2 class="i18n" data-en="Built for consistency and speed." data-pt="Construído para consistência e velocidade.">Built for consistency and speed.</h2>
        </div>

        <div class="decision-list" data-stagger>
          {decisions.map((d) => (
            <article>
              <h3 class="pname i18n" data-en={d.title.en} data-pt={d.title.pt}>{d.title.en}</h3>
              <p class="pdesc i18n" data-en={d.body.en} data-pt={d.body.pt}>{d.body.en}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="case-section">
      <div class="wrap" data-reveal>
        <div class="head">
          <div class="k i18n" data-en="The solution" data-pt="A solução">The solution</div>
          <h2 class="i18n" data-en="Four surfaces around one shared design system." data-pt="Quatro superfícies em torno de um design system compartilhado.">Four surfaces around one shared design system.</h2>
        </div>

        <div class="ecosystem" data-stagger>
          {ecosystem.map((item) => (
            <article class="eco-item">
              <div class="eco-top">
                <h3 class="pname i18n" data-en={item.name.en} data-pt={item.name.pt}>{item.name.en}</h3>
                <span class="tag">{item.type}</span>
              </div>
              <p class="pdesc i18n" data-en={item.detail.en} data-pt={item.detail.pt}>{item.detail.en}</p>
            </article>
          ))}
        </div>
        <p class="stack mono eco-metric i18n" data-en="4 surfaces · 2 web apps + 2 installable PWAs · one design system" data-pt="4 superfícies · 2 apps web + 2 PWAs instaláveis · um design system">4 surfaces · 2 web apps + 2 installable PWAs · one design system</p>
      </div>
    </section>

    <section class="case-section">
      <div class="wrap split" data-reveal>
        <div class="head section-head">
          <div class="k i18n" data-en="The outcome" data-pt="O resultado">The outcome</div>
          <h2 class="i18n" data-en="MVP shipped, ready to validate." data-pt="MVP entregue, pronto para validar.">MVP shipped, ready to validate.</h2>
        </div>
        <div class="copy">
          <p
            class="i18n"
            data-en="The MVP is built: all four surfaces run on the shared codebase and design system, from scheduling to loyalty. The next business goal is validation with 100 paying barbershops."
            data-pt="O MVP está construído: as quatro superfícies rodam na base e no design system compartilhados, da agenda à fidelidade. A próxima meta de negócio é a validação com 100 barbearias pagantes."
          >
            The MVP is built: all four surfaces run on the shared codebase and design system, from
            scheduling to loyalty. The next business goal is validation with 100 paying barbershops.
          </p>
          <p class="stack mono i18n" data-en="MVP live on one codebase · next: 100 paying shops" data-pt="MVP rodando numa base única · próximo passo: 100 barbearias pagantes">MVP live on one codebase · next: 100 paying shops</p>
        </div>
      </div>
    </section>

    <section class="case-section gallery-section">
      <div class="wrap" data-reveal>
        <div class="head">
          <div class="k i18n" data-en="The product" data-pt="O produto">The product</div>
          <h2 class="i18n" data-en="The real dashboard, running." data-pt="O painel real, rodando.">The real dashboard, running.</h2>
        </div>

        <div class="case-gallery">
          <div class="panel stage-gold case-panel">
            <div class="stage">
              <div class="browser">
                <div class="browser-bar">
                  <i></i><i></i><i></i>
                  <span class="url mono">app.bboss.club/home</span>
                </div>
                <div class="browser-view">
                  <video
                    class="dash-video"
                    data-gate
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster="/media/bboss-dashboard-poster.webp"
                    aria-label="B-Boss Club web dashboard, scrolling through live metrics and scheduling"
                  >
                    <source src="/media/bboss-dashboard.webm" type="video/webm" />
                    <source src="/media/bboss-dashboard.mp4" type="video/mp4" />
                  </video>
                </div>
              </div>
            </div>
            <span class="lightbands" aria-hidden="true"></span>
          </div>

          <div class="panel stage-gold case-panel-phones">
            <div class="case-phone-row">
              {screens.map((screen) => (
                <div class="device device-sm">
                  <div class="device-screen">
                    <span class="device-island"></span>
                    <div class="screens">
                      <div class="screen is-active">
                        <Image
                          src={screen.src}
                          alt={screen.alt}
                          widths={[220, 360, 520]}
                          sizes="150px"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <span class="lightbands" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="case-cta">
      <div class="wrap" data-reveal>
        <div class="head">
          <div class="k i18n" data-en="Next" data-pt="Próximo">Next</div>
          <h2 class="i18n" data-en="See the rest of the work." data-pt="Veja o resto dos projetos.">See the rest of the work.</h2>
        </div>
        <div class="cta-row">
          <a class="btn primary i18n" href="/#work" data-en="Back to work" data-pt="Voltar aos projetos">Back to work</a>
          <a class="btn" href="mailto:contact@gabrielandrade.com">contact@gabrielandrade.com</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .case {
    overflow: clip;
  }

  .case-hero {
    padding-top: clamp(42px, 7vw, 86px);
    padding-bottom: clamp(58px, 8vw, 104px);
  }

  .back-link {
    display: inline-flex;
    color: var(--text-muted);
    font-size: 13px;
    margin-bottom: 44px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .case-head {
    max-width: 820px;
    margin-bottom: 0;
  }

  .case-head h2 {
    font-size: clamp(2.9rem, 8vw, 5.4rem);
    max-width: 9ch;
  }

  .case-head p {
    font-size: clamp(1.02rem, 1.5vw, 1.18rem);
  }

  .metric {
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-section,
  .case-cta {
    border-top: 1px solid var(--line);
  }

  .split {
    display: grid;
    grid-template-columns: 0.42fr 0.58fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .section-head {
    margin-bottom: 0;
  }

  .copy {
    color: var(--text-muted);
    max-width: 58ch;
  }

  .copy p {
    margin: 0;
  }

  .copy p + p {
    margin-top: 18px;
  }

  .stack {
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ecosystem {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .eco-item {
    min-height: 240px;
    padding: clamp(20px, 2.8vw, 30px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-elevated);
  }

  .eco-top {
    display: flex;
    min-height: 108px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .eco-item .pname,
  .decision-list .pname {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
  }

  .eco-metric {
    margin-top: 22px;
  }

  .case-gallery {
    display: grid;
    gap: clamp(18px, 3vw, 32px);
  }

  /* let the framed shots define their own height (no forced 16/10 crop here) */
  .case-panel,
  .case-panel-phones {
    aspect-ratio: auto;
  }

  .case-phone-row {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 28px);
    width: 100%;
  }

  .device-sm {
    width: clamp(122px, 15vw, 152px);
  }

  .decision-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .decision-list article {
    padding: clamp(22px, 3vw, 32px);
    background: var(--bg);
  }






  .case-cta {
    padding-block: clamp(72px, 10vw, 120px);
  }

  .case-cta .head {
    margin-bottom: 28px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media (max-width: 980px) {
    .split,
    .decision-list {
      grid-template-columns: 1fr;
    }

    .ecosystem {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .eco-item {
      min-height: 220px;
    }
  }

  @media (max-width: 700px) {
    .case-hero {
      padding-top: 34px;
    }

    .back-link {
      margin-bottom: 34px;
    }

    .ecosystem {
      grid-template-columns: 1fr 1fr;
    }

    .eco-item {
      min-height: 190px;
    }

    .eco-top {
      min-height: 96px;
    }
  }

  @media (max-width: 480px) {
    .ecosystem {
      grid-template-columns: 1fr;
    }

    .cta-row .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
