---
const email = "contact@gabrielandrade.com";
---

<section id="contact" class="contact">
  <div class="wrap">
    <h2>Let's talk.</h2>
    <p class="contact-sub">English or Portuguese, both fine. Replies within a day.</p>

    <div class="hero-actions">
      <button class="btn primary copy-email" type="button" data-email={email}>Copy email</button>
      <a class="btn" href={`mailto:${email}`}>{email}</a>
    </div>

    <div class="links">
      <a class="link" href="https://www.linkedin.com/in/gabrieltech/" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="link" href="https://github.com/Gabriel300p" target="_blank" rel="noopener">GitHub ↗</a>
      <a class="link" href="https://coverletter.gabrielandrade.com/" target="_blank" rel="noopener">Résumé ↗</a>
    </div>
  </div>
</section>
