---
const email = "contact@gabrielandrade.com";
---

<section id="contact" class="contact">
  <div class="wrap">
    <h2
      data-reveal
      class="i18n"
      data-en="Let's make something <em>good.</em>"
      data-pt="Vamos fazer algo <em>bom.</em>"
    >
      Let's make something <em>good.</em>
    </h2>
    <p
      data-reveal
      class="i18n"
      data-en="Have a product that needs design and engineering in the same head? Say hello."
      data-pt="Tem um produto que precisa de design e engenharia na mesma cabeça? Manda um oi."
    >
      Have a product that needs design and engineering in the same head? Say hello.
    </p>

    <div class="btn-row" data-reveal>
      <button class="btn primary copy-email" type="button" data-email={email} data-magnetic>
        <span class="i18n" data-en="Copy email" data-pt="Copiar email">Copy email</span>
      </button>
      <a class="btn" href={`mailto:${email}`} data-magnetic>{email}</a>
    </div>

    <div class="links" data-reveal>
      <a href="https://www.linkedin.com/in/gabrieltech/" target="_blank" rel="noopener">
        <span class="k">in</span> linkedin.com/in/gabrieltech
      </a>
      <a href="https://github.com/Gabriel300p" target="_blank" rel="noopener">
        <span class="k">gh</span> github.com/Gabriel300p
      </a>
      <a href="https://coverletter.gabrielandrade.com/" target="_blank" rel="noopener">
        <span class="k">cv</span> <span class="i18n" data-en="résumé" data-pt="currículo">résumé</span>
      </a>
    </div>
  </div>
</section>
