---
import { credentials, languages } from "../data/content";

const featured = credentials.filter((c) => c.featured);
const rest = credentials.filter((c) => !c.featured);

// Real institution logos (in public/logos). FIAP is a vector wordmark; the rest
// are square brand marks. Falls back to the monogram when an issuer has none.
const logoMap: Record<string, string> = {
  FIAP: "/logos/fiap.svg",
  Google: "/logos/google.png",
  Alura: "/logos/alura.png",
  Rocketseat: "/logos/rocketseat.png",
  "FIA Business School": "/logos/fia.png",
  Udemy: "/logos/udemy.png",
  "Curso em Vídeo": "/logos/cursoemvideo.png",
};
const logoFor = (inst: string): string | undefined => logoMap[inst];
---

<section id="education">
  <div class="wrap">
    <div class="head" data-reveal>
      <div class="k i18n" data-en="Studies" data-pt="Estudos">Studies</div>
      <h2 class="i18n" data-en="What I've <em>studied.</em>" data-pt="O que eu <em>estudei.</em>">
        What I've <em>studied.</em>
      </h2>
    </div>

    <div class="edu-list" data-stagger>
      {
        featured.map((c) => (
          <article class="edu" data-kind={c.kind}>
            <div class="edu-side">
              <span class="edu-logo" data-inst={c.institution}>
                {logoFor(c.institution) ? (
                  <img src={logoFor(c.institution)} alt={c.institution} loading="lazy" width="30" height="30" />
                ) : (
                  <span class="edu-logo-fallback" aria-hidden="true">
                    {c.monogram}
                  </span>
                )}
              </span>
              <span class="edu-inst">{c.institution}</span>
            </div>

            <div class="edu-body">
              <h3 class="edu-title i18n" data-en={c.title.en} data-pt={c.title.pt}>
                {c.title.en}
              </h3>
              <div class="edu-meta mono">
                <span class="edu-period">{c.period}</span>
                {c.proof && (
                  <>
                    <span class="edu-meta-sep">·</span>
                    <span class="edu-proof i18n" data-en={c.proof.en} data-pt={c.proof.pt}>
                      {c.proof.en}
                    </span>
                  </>
                )}
                {c.url && (
                  <a class="edu-verify" href={c.url} target="_blank" rel="noopener noreferrer">
                    <span class="i18n" data-en="Verify" data-pt="Verificar">Verify</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                )}
              </div>
              {c.topics && (
                <div class="edu-tags">
                  {c.topics.map((t) => (
                    <span class="edu-tag">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {
      rest.length > 0 && (
        <div class="edu-more" data-stagger>
          <button
            class="edu-more-btn"
            type="button"
            aria-expanded="false"
            aria-controls="edu-more-panel"
          >
            <span class="i18n" data-en="More certificates" data-pt="Mais certificados">
              More certificates
            </span>
            <span class="edu-more-count mono">({rest.length})</span>
            <span class="edu-more-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </button>

          <div class="edu-more-panel" id="edu-more-panel">
            <ul class="edu-cert-list">
              {
                rest.map((c) => {
                  const Row = c.url ? "a" : "div";
                  const linkAttrs = c.url
                    ? { href: c.url, target: "_blank", rel: "noopener noreferrer" }
                    : {};
                  return (
                    <li class="edu-cert">
                      <Row class="edu-cert-row" data-link={c.url ? "true" : undefined} {...linkAttrs}>
                        <span class="edu-cert-logo" data-inst={c.institution}>
                          {logoFor(c.institution) ? (
                            <img src={logoFor(c.institution)} alt={c.institution} loading="lazy" width="30" height="30" />
                          ) : (
                            <span class="edu-logo-fallback" aria-hidden="true">
                              {c.monogram}
                            </span>
                          )}
                        </span>
                        <span class="edu-cert-text">
                          <span class="edu-cert-title i18n" data-en={c.title.en} data-pt={c.title.pt}>
                            {c.title.en}
                          </span>
                          <span class="edu-cert-sub mono">
                            {c.institution} · {c.period}
                          </span>
                        </span>
                        {c.url && (
                          <span class="edu-cert-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </span>
                        )}
                      </Row>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </div>
      )
    }

    <div class="edu-langs" data-stagger>
      <div class="edu-langs-head">
        <span class="edu-langs-label mono i18n" data-en="Languages" data-pt="Idiomas">Languages</span>
        <span class="edu-langs-tag mono i18n"
          data-en="Ready for international teams"
          data-pt="Pronto para times internacionais"
        >
          Ready for international teams
        </span>
      </div>

      <div class="edu-lang-grid">
        {
          languages.map((l) => (
            <article class="lang" data-accent={l.accent ? "true" : undefined}>
              <span class="lang-flag">
                <img src={`/flags/${l.flag}.svg`} alt="" loading="lazy" width="48" height="48" />
              </span>
              <div class="lang-body">
                <div class="lang-top">
                  <h3 class="lang-name i18n" data-en={l.name.en} data-pt={l.name.pt}>
                    {l.name.en}
                  </h3>
                  {l.cefr && <span class="lang-cefr mono">{l.cefr}</span>}
                </div>
                <div class="lang-level i18n" data-en={l.level.en} data-pt={l.level.pt}>
                  {l.level.en}
                </div>
                <div class="lang-meter" aria-hidden="true">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class="lang-pip" data-on={i < l.proficiency ? "true" : "false"} />
                  ))}
                </div>
                <p class="lang-note i18n" data-en={l.note.en} data-pt={l.note.pt}>
                  {l.note.en}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
