---
// Sticky top navigation with theme toggle (sun/moon) and language toggle.
---

<div id="top-sentinel" aria-hidden="true" style="position:absolute;top:0;left:0;height:1px;width:1px;"></div>

<nav class="nav" id="nav" aria-label="Main">
  <div class="wrap">
    <a href="/#top" class="brand">Gabriel Andrade<span class="gp">.</span></a>

    {/* absolute /#hash links so the nav also works from /work/* pages */}
    <div class="nav-links">
      <a href="/#work" class="i18n" data-en="Work" data-pt="Projetos">Work</a>
      <a href="/#stack" class="i18n" data-en="Stack" data-pt="Stack">Stack</a>
      <a href="/#experience" class="i18n" data-en="Experience" data-pt="Experiência">Experience</a>
      <a href="/#education" class="i18n" data-en="Studies" data-pt="Estudos">Studies</a>
      <a href="/#contact" class="i18n" data-en="Contact" data-pt="Contato">Contact</a>
    </div>

    <div class="nav-right">
      <button
        class="icon-btn nav-burger"
        id="navBurger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="navMenu"
      >
        <svg class="i-burger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
      <button
        class="icon-btn"
        id="themeBtn"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
        </svg>
      </button>
      <button class="lang" id="langBtn" type="button" aria-label="Switch language between English and Portuguese">PT<b> / </b>EN</button>
    </div>
  </div>

  {/* mobile menu — same absolute /#hash links, staggered entrance */}
  <div class="nav-menu" id="navMenu" inert>
    <a href="/#work" class="i18n" data-en="Work" data-pt="Projetos" style="--i: 0">Work</a>
    <a href="/#stack" class="i18n" data-en="Stack" data-pt="Stack" style="--i: 1">Stack</a>
    <a href="/#experience" class="i18n" data-en="Experience" data-pt="Experiência" style="--i: 2">Experience</a>
    <a href="/#education" class="i18n" data-en="Studies" data-pt="Estudos" style="--i: 3">Studies</a>
    <a href="/#contact" class="i18n" data-en="Contact" data-pt="Contato" style="--i: 4">Contact</a>
  </div>
</nav>
