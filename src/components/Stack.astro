---
import { skillGroups } from "../data/content";
---

<section id="stack">
  <div class="wrap">
    <div class="head">
      <div class="k">Stack</div>
      <h2>What I work with.</h2>
    </div>

    <div class="stack-groups">
      {
        skillGroups.map((g) => (
          <div class="stack-group">
            <h3>{g.label}</h3>
            <ul>
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
