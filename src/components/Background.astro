---
import { experience, credentials, languages } from "../data/content";
---

<section id="experience">
  <div class="wrap">
    <div class="bg-cols">
      <div class="bg-col">
        <span class="k">Experience</span>
        {
          experience.map((job) => (
            <article class="xp">
              <div class="xp-head">
                <span class="xp-company">{job.company}</span>
                <span class="xp-period">{job.period}</span>
              </div>
              <p class="xp-role">
                {job.role} · {job.employment}
              </p>
              <ul class="xp-bullets">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="bg-col" id="education">
        <span class="k">Education</span>
        {
          credentials.map((c) => (
            <article class="edu">
              <div class="edu-head">
                <span class="edu-title">{c.title}</span>
                <span class="edu-meta">{c.period}</span>
              </div>
              <p class="edu-inst">
                {c.institution} · {c.proof}
              </p>
            </article>
          ))
        }
        <div class="langs">
          {
            languages.map((l) => (
              <p>
                {l.name} <span>· {l.level}</span>
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
