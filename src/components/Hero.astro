---
interface Props { track?: 'home' | 'design' | 'engineering' }
const { track = 'home' } = Astro.props;
const copy = {
  home: { label:'Software Engineer', title:'Software engineering.<br/><span>AI agents &amp; automation.</span>', lede:'I develop agent workflows and operational tools through Pandora, alongside web products built with TypeScript and React. My professional background spans frontend development, API integrations and reusable systems since 2021.', facts:'Agent workflows · Developer tooling · Web products', open:'Open to engineering roles' },
  design: { label:'AI-Native Product Designer', title:'Complex systems.<br/><span>Clear product experiences.</span>', lede:'I connect research, Figma design systems and working React prototypes. My cases show how I frame decisions, make operational states understandable and collaborate with engineering through delivery.', facts:'Product design · Design systems · AI experiences', open:'Open to product design roles' },
  engineering: { label:'AI Product / Agent Engineer', title:'Agent workflows.<br/><span>Reviewable product systems.</span>', lede:'I specify, integrate and verify agent-assisted workflows while building interfaces and APIs with TypeScript, React, Python tooling, Rust and SQLite. Pandora is the clearest evidence of that transition.', facts:'Agent orchestration · React · Developer tooling', open:'Open to product engineering roles' }
}[track];
---
<header class="hero" id="top"><div class="wrap">
<p class="k">Gabriel Andrade <span class="hero-divider">/</span> {copy.label}</p>
<h1 set:html={copy.title}></h1>
<div class="hero-bottom"><p class="hero-lede">{copy.lede}</p>
<a class="text-link" href="#work">Explore selected work <span aria-hidden="true">↓</span></a></div>
<div class="hero-facts"><span>Based in Guarulhos, Brazil</span><span>{copy.facts}</span><a href="#contact">{copy.open} ↗</a></div>
</div></header>
