---
import { projects } from "../data/projects";
interface Props { order?: string[]; label?: string }
const { order = projects.map(p => p.slug), label = 'Agent workflows · Product engineering' } = Astro.props;
const selected = order.map(slug => projects.find(p => p.slug === slug)).filter(Boolean);
---
<section id="work" class="work-index">
  <div class="wrap">
    <div class="section-heading">
      <h2>Selected work</h2>
      <span class="k">{label}</span>
    </div>
    <div class="project-list">
      {selected.map(p => p && (
        <article class="project-row">
          <span class="project-number" aria-hidden="true">{p.number}</span>
          <div class="project-identity">
            <h3><a href={`/work/${p.slug}/`}>{p.name}</a></h3>
            <p class="project-category">{p.category}</p>
          </div>
          <div class="project-excerpt">
            <p>{p.summary}</p>
            <a class="text-link" href={`/work/${p.slug}/`} aria-label={`Read case study: ${p.name}`}>Read case study <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
