---
import { quotes } from "../data/content";
---

<section id="words">
  <div class="wrap">
    <div class="head">
      <div class="k">In their words</div>
      <h2>People I've worked with.</h2>
    </div>

    <div class="quotes">
      {
        quotes.map((q) => (
          <figure class="quote">
            <blockquote>{q.text}</blockquote>
            <figcaption>
              <b>{q.name}</b>
              <span>{q.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
