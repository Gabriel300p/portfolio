---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Gabriel Andrade · Design Engineer",
  description = "Gabriel Andrade — a design engineer from São Paulo. I design and build web products end to end, from Figma to production.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/Geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Gabriel Andrade",
        jobTitle: "Design Engineer",
        url: "https://gabrielandrade.com",
        sameAs: ["https://www.linkedin.com/in/gabrieltech/", "https://github.com/Gabriel300p"],
        address: { "@type": "PostalAddress", addressLocality: "São Paulo", addressCountry: "BR" },
      })}
    />

    {/* The Pandora diagram hides only while JS is running (html.reveal) so it can draw in.
        Without this class, or if the UI module never executes, everything stays visible. */}
    <script is:inline>
      (function () {
        try {
          document.documentElement.classList.add("js", "reveal");
          setTimeout(function () {
            if (!window.__uiReady) document.documentElement.classList.remove("reveal");
          }, 1200);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import "../scripts/ui.ts";
    </script>
  </body>
</html>
